% VERIFIED -- arxiv.org/abs/2603.19022 opened.
% Closest prior art. Self-baselining, e-value sequential evidence, energy
% distance with permutation testing, 800 requests per fingerprint. Its
% limitations section names partial routing and adversarial providers as open,
% which is this paper's motivation -- cite that explicitly in related work.
@article{leshin2026behavioral,
  title   = {Behavioral Fingerprints for {LLM} Endpoint Stability and Identity},
  author  = {Leshin and Shah and Timmis and Kang},
  journal = {arXiv preprint arXiv:2603.19022},
  year    = {2026},
  note    = {Author given names not captured; complete before submission}
}

% VERIFIED -- arxiv.org/abs/2607.10252 opened.
% 165 models, 326k requests. Jensen-Shannon on single-token PMFs. Reference-based
% one-shot identification, ~100 queries per audit; 59.5% lineage recovery,
% 7.3% equal error rate.
@article{bruckner2026onetoken,
  title   = {One Token Is Enough: Fingerprinting and Verifying Large Language
             Models from Single-Token Output Distributions},
  author  = {Bruckner, Tomas},
  journal = {arXiv preprint arXiv:2607.10252},
  year    = {2026}
}

